datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Project {
  id            String   @id @default(uuid())
  seriesName    String
  chapterNumber Int
  episodeTitle  String
  status        String   @default("idle")
  durationEst   Float    @default(0)
  coverUrl      String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  chapters      Chapter[]
  scripts       ScriptData[]
}

model Chapter {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  createdAt DateTime @default(now())
  pages     MangaPage[]
}

model MangaPage {
  id        String   @id @default(uuid())
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  pageIndex Int
  imageUrl  String
  panels    Panel[]
}

model Panel {
  id                   String     @id @default(uuid())
  pageId               String
  page                 MangaPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  panelIndex           Int
  bboxX                Float
  bboxY                Float
  bboxW                Float
  bboxH                Float
  suggestedCameraEffect String     @default("zoom_in")
  aiDescription        String     @default("")
  dialogues            Dialogue[]
}

model Dialogue {
  id             String  @id @default(uuid())
  panelId        String
  panel          Panel   @relation(fields: [panelId], references: [id], onDelete: Cascade)
  speaker        String
  text           String
  translatedText String  @default("")
  emotion        String  @default("neutral")
}

model ScriptData {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mode      String
  title     String
  content   String
  wordCount Int      @default(0)
  createdAt DateTime @default(now())
}

model QueueTask {
  id           String   @id @default(uuid())
  seriesName   String
  chapterTitle String
  progress     Int      @default(0)
  currentStep  String
  status       String   @default("queued")
  startedAt    DateTime @default(now())
  logs         String   @default("[]")
}
