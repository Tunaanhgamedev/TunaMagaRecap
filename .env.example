# TunaRecap AI Vision & Translation API Configuration
# Copy this file to .env and add your private API keys

# Google Gemini API Key (Recommended - Free & Ultra Fast for Manga Vision OCR)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Alternative for GPT-4o Vision)
OPENAI_API_KEY=

# Server Configuration
PORT=3001
NODE_ENV=development

# Vbee AIVoice Studio API Configuration (Optional - For Original Vbee High Quality Voices)
# Get your App ID and Access Token at: https://vbee.vn
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
